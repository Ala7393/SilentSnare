@bp.route('/send_modified_http', methods=['POST'])
@json_response
def send_modified_http():
    data = request.get_json()
    modified_payload = data.get('payload')

    with intercepted_requests_lock:
        if not intercepted_requests:
            return jsonify({'status': 'error', 'message': 'No intercepted request'}), 400
        req = intercepted_requests[-1]
        intercepted_requests.pop()

    # استخراج Host والطريقة والمسار
    data_str = req['data']
    lines = data_str.split('\r\n')
    first_line = lines[0] if lines else ''
    parts = first_line.split(' ')
    if len(parts) < 2:
        return jsonify({'status': 'error', 'message': 'Invalid request line'}), 400
    method = parts[0].upper()
    path = parts[1]
    host_match = re.search(r'Host:\s*([^\r\n]+)', data_str, re.IGNORECASE)
    if not host_match:
        return jsonify({'status': 'error', 'message': 'Could not extract host header'}), 400
    host = host_match.group(1).strip()
    if ':' in host:
        target_host, target_port = host.split(':')
        target_port = int(target_port)
    else:
        target_host = host
        target_port = 80

    import socket
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(10)
        sock.connect((target_host, target_port))
        sock.send(modified_payload.encode('utf-8'))
        response = sock.recv(4096)
        sock.close()
        return jsonify({'status': 'success', 'message': f'Modified request sent. Response length: {len(response)}'})
    except Exception as e:
        return jsonify({'status': 'error', 'message': str(e)}), 500

