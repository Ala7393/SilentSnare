# ╔══════════════════════════════════════════════════════════════════╗
# ║             SilentSnare — Environment Configuration              ║
# ║             MITM Educational Platform v2.0                       ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# SETUP:
#   cp .env.example .env
#   nano .env        ← edit your values
#
# ─────────────────────────────────────────────────────────────────────


# ─── Flask Security ───────────────────────────────────────────────────
# REQUIRED: Change this to a long random string before running
# Generate a strong key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret-key


# ─── Server Configuration ─────────────────────────────────────────────
# Port the Flask server listens on (default: 5000)
PORT=5000

# Set to 0.0.0.0 to listen on all interfaces (required for LAN access)
# Set to 127.0.0.1 for localhost only
HOST=0.0.0.0


# ─── Debug Mode ───────────────────────────────────────────────────────
# NEVER enable in production or on real networks
# Only use for development purposes
DEBUG=False


# ─── Database ─────────────────────────────────────────────────────────
# SQLite database file path (relative to project root)
# Default: silentsnare.db (auto-created on first run)
# DATABASE_PATH=silentsnare.db


# ─── Session ──────────────────────────────────────────────────────────
# Session cookie lifetime in seconds (default: 3600 = 1 hour)
# SESSION_LIFETIME=3600
